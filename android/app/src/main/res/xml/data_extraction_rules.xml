<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing leaves the device, neither by cloud backup nor by
     device-to-device transfer (allowBackup="false" doesn't stop the latter).
     The saved folder, port and engine secret describe this device, and the
     server connection (nexote-secrets) is encrypted with a key that only
     this device's keystore holds. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
